# ==============================================================================
# Music Server - Environment Configuration
# Copy this file to `.env` (`cp .env.example .env`) and adjust for your setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Settings (MySQL / MariaDB)
# ------------------------------------------------------------------------------
# When running with Docker Compose:
#   - Use 'host.docker.internal' if MySQL runs on the host machine.
#   - Or use container service name if running MySQL in Docker.
# When running backend locally without Docker:
#   - Use 'localhost' or '127.0.0.1'.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=musicapp
MYSQL_PASSWORD=change-me-to-a-secure-password
MYSQL_DATABASE=musicapp

# ------------------------------------------------------------------------------
# Security & Sessions
# ------------------------------------------------------------------------------
# Secret key used for session signing. Generate a strong key with:
#   openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key

# How long a login session lasts in days (default: 30)
SESSION_DAYS=30

# Cookie security flag:
#   - Set to "true" in production behind HTTPS (e.g. via Nginx Proxy Manager).
#   - Set to "false" ONLY when testing locally over plain HTTP (http://localhost:8000),
#     otherwise login cookies will be rejected by the browser and login will fail.
COOKIE_SECURE=true

# Address of your reverse proxy (Nginx Proxy Manager), as the container sees it. Only this address may
# set the client IP that the login/registration rate limits count by. Comma-separated; CIDR ranges work.
# Leave unset to trust nobody (then every user shares one rate limit). Never use "*" if port 8000 is reachable.
FORWARDED_ALLOW_IPS=172.17.0.1

# ------------------------------------------------------------------------------
# Storage & Upload Limits
# ------------------------------------------------------------------------------
# Maximum single track upload size in Megabytes (default: 200).
# Note: Ensure your reverse proxy (e.g., Nginx client_max_body_size) matches or exceeds this.
MAX_UPLOAD_MB=200

# Path where audio files and cover art are stored:
#   - In Docker: '/data' (mounted from ./data)
#   - For local dev: './data'
DATA_DIR=/data

# ------------------------------------------------------------------------------
# Frontend Static Assets
# ------------------------------------------------------------------------------
# Directory containing built React static files served by the backend:
#   - In Docker: '/app/static'
#   - For local dev: '../frontend/dist' (or leave unset when running Vite dev server)
STATIC_DIR=/app/static
